{
    "i18n": true,
    "type": "tabs",
    "tabsStyle": {
        "width": "calc(100% - 100px)"
    },
    "items": {
        "_config": {
            "type": "panel",
            "label": "Web Server",
            "items": {
                "bind": {
                    "type": "ip",
                    "label": "Own IP address",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "port": {
                    "type": "port",
                    "label": "Port",
                    "default": 80,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "secure": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Secure(HTTPS)",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_certs": {
                    "type": "certificates",
                    "newLine": true,
                    "hidden": "!data.secure",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "retryInterval": {
                    "newLine": true,
                    "type": "number",
                    "label": "Retry Interval",
                    "help": "Adapter will retry every X seconds to open the web server on the given port",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "acmeChallenge": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Answer ACME HTTP-01 challenges",
                    "help": "Let the acme adapter renew Let's Encrypt certificates over this port without stopping this adapter",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_settings": {
            "type": "panel",
            "label": "Settings",
            "items": {
                "redirectToLink": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Redirect to custom link",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "redirectUrl": {
                    "newLine": true,
                    "type": "text",
                    "label": "Custom URL",
                    "validator": "!data.redirectToLink || !!data.redirectUrl",
                    "validatorErrorText": "URL must be set",
                    "validatorNoSaveOnError": true,
                    "tooltip": "User will be immediately redirected to this link after opening of the page",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!data.redirectToLink"
                },
                "redirect": {
                    "newLine": true,
                    "type": "instance",
                    "label": "Redirect to instance by opening of the page",
                    "default": "",
                    "adapters": ["admin", "web"],
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.redirectToLink"
                },
                "welcomePhrase": {
                    "newLine": true,
                    "type": "text",
                    "label": "Welcome Phrase",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "hidden": "!!data.redirect || !!data.redirectToLink"
                },
                "backgroundColor": {
                    "newLine": true,
                    "type": "color",
                    "label": "Background Color",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.redirect || !!data.redirectToLink"
                },
                "backgroundToolbarColor": {
                    "newLine": true,
                    "type": "color",
                    "label": "Toolbar background Color",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.redirect || !!data.redirectToLink"
                },
                "language": {
                    "newLine": true,
                    "type": "language",
                    "label": "Language",
                    "system": true,
                    "noTranslation": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.redirect || !!data.redirectToLink"
                },
                "logo.png": {
                    "newLine": true,
                    "type": "image",
                    "label": "Logo",
                    "accept": { "image/*": [] },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.redirect || !!data.redirectToLink"
                },
                "_custom": {
                    "newLine": true,
                    "type": "custom",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 6,
                    "xl": 6,
                    "i18n": true,
                    "bundlerType": "module",
                    "guiApi": 2,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomWelcomeSet/Components/WelcomeComponent",
                    "hidden": "!!data.redirect || !!data.redirectToLink"
                }
            }
        },
        "_custom": {
            "type": "panel",
            "label": "Custom links",
            "hidden": "!!data.redirect || !!data.redirectToLink",
            "items": {
                "customLinks": {
                    "type": "table",
                    "items": [
                        { "type": "checkbox", "width": 50, "attr": "enabled", "title": "Enabled" },
                        { "type": "text", "width": "20%", "attr": "name", "title": "Name" },
                        { "type": "text", "width": "20%", "attr": "link", "title": "Link" },
                        { "type": "text", "width": "20%", "attr": "desc", "title": "Description" },
                        {
                            "type": "image",
                            "base64": true,
                            "accept": { "image/*": [] },
                            "width": "20%",
                            "attr": "icon",
                            "title": "Icon",
                            "maxSize": 1024000
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
